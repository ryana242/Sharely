<?xml version="1.0" encoding="utf-8"?>
<!-- Clear keyboard-focus state without changing the Browse search field's size. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sharely_surface" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="@color/sharely_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sharely_surface" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/sharely_border" />
        </shape>
    </item>
</selector>
