<?xml version="1.0" encoding="utf-8"?>
<!-- Visible focus feedback for all listing/account input fields. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sharely_surface" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/sharely_primary" />
            <padding android:left="16dp" android:top="12dp" android:right="16dp" android:bottom="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sharely_surface" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/sharely_border" />
            <padding android:left="16dp" android:top="12dp" android:right="16dp" android:bottom="12dp" />
        </shape>
    </item>
</selector>
