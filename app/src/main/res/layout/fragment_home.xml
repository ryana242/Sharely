<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sharely_page"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="40dp">

        <!-- One familiar headline, now presented as a strong visual hero. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="228dp"
            android:background="@drawable/bg_home_hero_v3"
            android:clipChildren="true">

            <ImageView
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="-50dp"
                android:alpha="0.20"
                android:contentDescription="@null"
                android:src="@drawable/sharely_mark"
                android:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="25dp"
                android:paddingEnd="25dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Good things,&#10;shared."
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.035"
                    android:lineSpacingExtra="-3dp"
                    android:textSize="36sp" />

                <TextView
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Find what you need. Share what you have."
                    android:textColor="#E6F4EB"
                    android:fontFamily="sans-serif"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Equal prominence: borrowing and lending. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/searchHome"
                android:layout_width="0dp"
                android:layout_height="165dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_home_action"
                android:orientation="vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Find an item">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:background="@drawable/bg_home_icon_surface"
                    android:src="@drawable/ic_nav_browse"
                    android:tint="@color/sharely_primary"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Find an item"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/sharely_text_primary"
                    android:textSize="17sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Browse listings"
                    android:textColor="@color/sharely_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonListHome"
                android:layout_width="0dp"
                android:layout_height="165dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_home_action"
                android:orientation="vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="List an item">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:background="@drawable/bg_home_icon_surface"
                    android:src="@drawable/ic_home_list"
                    android:tint="@color/sharely_primary"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="List an item"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/sharely_text_primary"
                    android:textSize="17sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Share your gear"
                    android:textColor="@color/sharely_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Actual Firestore listings, not demo items. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="29dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Explore items"
                android:textColor="@color/sharely_text_primary"
                android:fontFamily="sans-serif-medium"
                android:textSize="23sp" />
            <TextView
                android:id="@+id/homeSeeAll"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="4dp"
                android:text="See all  →"
                android:textColor="@color/sharely_primary"
                android:fontFamily="sans-serif-medium"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/homePreviewStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Loading available items…"
            android:textSize="14sp"
            android:textColor="@color/sharely_text_secondary" />

        <HorizontalScrollView
            android:id="@+id/homePreviewScroller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:fillViewport="false"
            android:scrollbars="none"
            android:overScrollMode="ifContentScrolls"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/homePreviewRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="6dp" />
        </HorizontalScrollView>

        <!-- Practical guidance, not another tagline. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="How it works"
            android:textColor="@color/sharely_text_primary"
            android:fontFamily="sans-serif-medium"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:background="@drawable/bg_home_guide_v3"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="01   Find an item"
                android:fontFamily="sans-serif-medium"
                android:textSize="15sp"
                android:textColor="@color/sharely_text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="38dp"
                android:text="Explore real listings from the community."
                android:textColor="@color/sharely_text_secondary"
                android:textSize="13sp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:background="#E4EFE9" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="02   Choose your dates"
                android:fontFamily="sans-serif-medium"
                android:textSize="15sp"
                android:textColor="@color/sharely_text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="38dp"
                android:text="Select an available borrowing period."
                android:textColor="@color/sharely_text_secondary"
                android:textSize="13sp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:background="#E4EFE9" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="03   Arrange the handover"
                android:fontFamily="sans-serif-medium"
                android:textSize="15sp"
                android:textColor="@color/sharely_text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="38dp"
                android:text="Chat with the owner once they accept."
                android:textColor="@color/sharely_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttonProfileHome"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_home_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Open your profile">
            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_nav_profile"
                android:tint="@color/sharely_primary"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="13dp"
                android:text="Your space"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/sharely_text_primary"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open profile  →"
                android:textSize="13sp"
                android:textColor="@color/sharely_primary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
