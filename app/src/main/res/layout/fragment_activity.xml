<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sharely_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="28dp"
        android:paddingRight="24dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Activity"
            android:textColor="@color/sharely_text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Keep track of what you're borrowing and sharing."
            android:textColor="@color/sharely_text_secondary"
            android:textSize="15sp" />


        <!-- Borrowing / Listings switch -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabBorrowing"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Borrowing"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabListings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Listings"
                android:textColor="@color/sharely_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- BORROWING -->

        <LinearLayout
            android:id="@+id/borrowingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ongoing"
                android:textColor="@color/sharely_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_sharely_feature_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/textOngoingSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No ongoing borrowings"
                    android:textColor="@color/sharely_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textOngoingDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Active rentals will appear here."
                    android:textColor="@color/sharely_text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Upcoming &amp; pending"
                android:textColor="@color/sharely_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_surface"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/textUpcomingSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nothing scheduled"
                    android:textColor="@color/sharely_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textUpcomingDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Pending requests and upcoming bookings will appear here."
                    android:textColor="@color/sharely_text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="History"
                android:textColor="@color/sharely_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textHistorySummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Completed and cancelled borrowings will appear here."
                android:textColor="@color/sharely_text_secondary"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- LISTINGS -->

        <LinearLayout
            android:id="@+id/listingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Active listings"
                android:textColor="@color/sharely_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_surface"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/textActiveListingsSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No active listings"
                    android:textColor="@color/sharely_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textActiveListingsDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Items you publish on Sharely will appear here."
                    android:textColor="@color/sharely_text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Unavailable &amp; past listings"
                android:textColor="@color/sharely_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textPastListingsSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Paused, unavailable and previous listings will appear here."
                android:textColor="@color/sharely_text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>