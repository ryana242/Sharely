<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemDetailsMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sharely_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="22dp"
        android:paddingTop="20dp"
        android:paddingRight="22dp"
        android:paddingBottom="36dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:backgroundTint="@android:color/transparent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="←"
                android:textAllCaps="false"
                android:textColor="@color/sharely_text_primary"
                android:textSize="24sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Item details"
                android:textColor="@color/sharely_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Item photos -->
        <HorizontalScrollView
            android:id="@+id/photoScroll"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="18dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/photoContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <!-- Item heading -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textItemName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Item name"
                android:textColor="@color/sharely_text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textItemPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="$0 / day"
                android:textColor="@color/sharely_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Location -->
        <TextView
            android:id="@+id/textItemInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Location"
            android:textColor="@color/sharely_text_secondary"
            android:textSize="14sp" />

        <!-- Description heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="About this item"
            android:textColor="@color/sharely_text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Description -->
        <TextView
            android:id="@+id/textItemDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:lineSpacingExtra="3dp"
            android:text="Item description"
            android:textColor="@color/sharely_text_secondary"
            android:textSize="15sp" />

        <!-- Booking card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose your borrowing period"
                android:textColor="@color/sharely_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Select when you'd like to borrow and return this item."
                android:textColor="@color/sharely_text_secondary"
                android:textSize="14sp" />

            <!-- Owner availability -->
            <TextView
                android:id="@+id/textOwnerAvailability"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_surface"
                android:padding="12dp"
                android:text="Loading owner availability..."
                android:textColor="@color/sharely_text_primary"
                android:textSize="14sp" />

            <!-- Start date -->
            <TextView
                android:id="@+id/textStartTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Start: Not selected"
                android:textColor="@color/sharely_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSelectStart"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Select start date &amp; time"
                android:textAllCaps="false"
                android:textColor="@color/sharely_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="16dp"
                app:strokeColor="@color/sharely_primary"
                app:strokeWidth="1dp" />

            <!-- End date -->
            <TextView
                android:id="@+id/textEndTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="End: Not selected"
                android:textColor="@color/sharely_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSelectEnd"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Select end date &amp; time"
                android:textAllCaps="false"
                android:textColor="@color/sharely_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="16dp"
                app:strokeColor="@color/sharely_primary"
                app:strokeWidth="1dp" />

            <!-- Request booking -->
            <Button
                android:id="@+id/buttonRequestBooking"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/button_primary"
                android:backgroundTint="@null"
                android:text="Request booking"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Message owner -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonMessageOwner"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:text="Message owner"
                android:textAllCaps="false"
                android:textColor="@color/sharely_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="16dp"
                app:strokeColor="@color/sharely_primary"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
