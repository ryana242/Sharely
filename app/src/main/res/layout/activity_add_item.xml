<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/addItemMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sharely_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="40dp">

        <!-- Top bar -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_sharely_back"
                android:backgroundTint="@null"
                android:src="@drawable/ic_sharely_back"
                android:scaleType="centerInside"
                android:padding="12dp"
                android:contentDescription="Back"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="List an item"
                android:textColor="@color/sharely_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Introduction -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Create your listing"
            android:textColor="@color/sharely_text_primary"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="Add clear details so borrowers know exactly what you're offering."
            android:textColor="@color/sharely_text_secondary"
            android:textSize="15sp" />

        <!-- Photos -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Photos"
            android:textColor="@color/sharely_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Help people understand the condition of your item."
            android:textColor="@color/sharely_text_secondary"
            android:textSize="13sp" />

        <!-- Selected photo previews -->

        <HorizontalScrollView
            android:id="@+id/photoPreviewScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/photoPreviewContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <!-- Add photos button -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAddPhoto"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:text="+  Add photos"
            android:textAllCaps="false"
            android:textColor="@color/sharely_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/sharely_soft"
            app:cornerRadius="18dp"
            app:strokeColor="@color/sharely_border"
            app:strokeWidth="1dp" />

        <!-- Item details -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="Item details"
            android:textColor="@color/sharely_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Item name -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Item name"
            android:textColor="@color/sharely_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editItemName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_field"
            android:hint="Enter item name"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:textColor="@color/sharely_text_primary"
            android:textColorHint="@color/sharely_text_secondary"
            android:textSize="15sp" />

        <!-- Description -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Description"
            android:textColor="@color/sharely_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editDescription"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_field"
            android:gravity="top|start"
            android:hint="Describe the item, its condition and anything borrowers should know"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="16dp"
            android:textColor="@color/sharely_text_primary"
            android:textColorHint="@color/sharely_text_secondary"
            android:textSize="15sp" />

        <!-- Category -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Category"
            android:textColor="@color/sharely_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editCategory"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_field"
            android:hint="Enter category"
            android:inputType="textCapWords"
            android:singleLine="true"
            android:textColor="@color/sharely_text_primary"
            android:textColorHint="@color/sharely_text_secondary"
            android:textSize="15sp" />

        <!-- Pricing -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="Pricing"
            android:textColor="@color/sharely_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Price per day"
            android:textColor="@color/sharely_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editPrice"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_field"
            android:hint="0.00"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:textColor="@color/sharely_text_primary"
            android:textColorHint="@color/sharely_text_secondary"
            android:textSize="15sp" />

        <!-- Location -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="Pickup location"
            android:textColor="@color/sharely_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="You can provide an approximate pickup area."
            android:textColor="@color/sharely_text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/editLocation"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/input_field"
            android:hint="Enter location"
            android:inputType="textCapWords"
            android:singleLine="true"
            android:textColor="@color/sharely_text_primary"
            android:textColorHint="@color/sharely_text_secondary"
            android:textSize="15sp" />

        <!-- Availability -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="Availability"
            android:textColor="@color/sharely_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Choose when borrowers can request this item."
            android:textColor="@color/sharely_text_secondary"
            android:textSize="13sp" />

        <!-- Set availability button -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSetAvailability"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="Set availability (start and end)"
            android:textAllCaps="false"
            android:textColor="@color/sharely_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@android:color/white"
            app:cornerRadius="16dp"
            app:strokeColor="@color/sharely_primary"
            app:strokeWidth="1dp" />

        <TextView
            android:id="@+id/textAvailabilitySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="No availability selected"
            android:textColor="@color/sharely_text_secondary"
            android:textSize="14sp" />

        <!-- Publish -->

        <Button
            android:id="@+id/buttonPublishItem"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/button_primary"
            android:backgroundTint="@null"
            android:text="Publish item"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
